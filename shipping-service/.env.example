SHIPPING_SERVER_PORT=8088
SHIPPING_DB_URL=jdbc:postgresql://localhost:5439/shipping_db
SHIPPING_DB_USERNAME=shipping
SHIPPING_DB_PASSWORD=shipping

AUTH_ISSUER=http://localhost:8085
AUTH_AUDIENCE=ecommerce-api
AUTH_JWK_SET_URI=http://localhost:8085/.well-known/jwks.json

ORDER_SERVICE_URL=http://localhost:8083
INVENTORY_SERVICE_URL=http://localhost:8082
ORDER_TO_SHIPPING_SERVICE_TOKEN=dev-order-to-shipping
SHIPPING_TO_ORDER_SERVICE_TOKEN=dev-shipping-to-order
SHIPPING_TO_INVENTORY_SERVICE_TOKEN=dev-shipping-to-inventory

# Use SANDBOX locally. Set EASYPOST only after supplying all production secrets below.
SHIPPING_PROVIDER=SANDBOX
SHIPPING_WEBHOOK_SECRET=dev-shipping-webhook-secret
SHIPPING_TIMEOUT_MS=5000
SHIPPING_CONNECT_TIMEOUT_MS=2000
SHIPPING_READ_TIMEOUT_MS=5000

# EasyPost production/test API configuration. Keep these out of Git.
EASYPOST_API_BASE_URL=https://api.easypost.com/v2
EASYPOST_API_KEY=
EASYPOST_WEBHOOK_SECRET=
EASYPOST_WEBHOOK_TIMESTAMP_TOLERANCE_MINUTES=1
EASYPOST_ORIGIN_NAME=
EASYPOST_ORIGIN_PHONE=
EASYPOST_ORIGIN_LINE1=
EASYPOST_ORIGIN_CITY=
EASYPOST_ORIGIN_STATE=
EASYPOST_ORIGIN_POSTAL_CODE=
EASYPOST_ORIGIN_COUNTRY=US
EASYPOST_DEFAULT_PARCEL_LENGTH=10
EASYPOST_DEFAULT_PARCEL_WIDTH=10
EASYPOST_DEFAULT_PARCEL_HEIGHT=10
EASYPOST_DEFAULT_PARCEL_WEIGHT=16
