PAYMENT_SERVER_PORT=8087

PAYMENT_DB_URL=jdbc:postgresql://localhost:5438/payment_db
PAYMENT_DB_USERNAME=payment
PAYMENT_DB_PASSWORD=payment

ORDER_SERVICE_URL=http://localhost:8083
ORDER_SERVICE_TOKEN=dev-payment-to-order
ORDER_PAYMENT_UPDATE_PATH=/internal/orders/{orderId}/payment-events
ORDER_CONNECT_TIMEOUT_MS=2000
ORDER_READ_TIMEOUT_MS=3000

AUTH_ISSUER=http://localhost:8085
AUTH_AUDIENCE=ecommerce-api
AUTH_JWK_SET_URI=http://localhost:8085/.well-known/jwks.json

PAYMENT_DEFAULT_PROVIDER=SANDBOX
PAYMENT_SANDBOX_WEBHOOK_SECRET=dev-sandbox-webhook-secret
PAYMENT_SUPPORTED_CURRENCIES=INR,USD,EUR

# Set false only for local development without Auth Service.
APP_SECURITY_ENABLED=true
