# Copy to deploy/single-vm/.env and replace every change-me value.
# This profile is intended for local integration and single-VM deployment.
# Never commit the copied .env file or real credentials.

POSTGRES_ADMIN_USER=ecommerce_admin
POSTGRES_ADMIN_PASSWORD=change-me-postgres-admin

CATALOG_DB_USERNAME=catalog_user
CATALOG_DB_PASSWORD=change-me-catalog-db
INVENTORY_DB_USERNAME=inventory_user
INVENTORY_DB_PASSWORD=change-me-inventory-db
ORDER_DB_USERNAME=order_user
ORDER_DB_PASSWORD=change-me-order-db
CART_DB_USERNAME=cart_user
CART_DB_PASSWORD=change-me-cart-db
AUTH_DB_USERNAME=auth_user
AUTH_DB_PASSWORD=change-me-auth-db
CUSTOMER_DB_USERNAME=customer_user
CUSTOMER_DB_PASSWORD=change-me-customer-db
PAYMENT_DB_USERNAME=payment_user
PAYMENT_DB_PASSWORD=change-me-payment-db
SHIPPING_DB_USERNAME=shipping_user
SHIPPING_DB_PASSWORD=change-me-shipping-db

AUTH_ISSUER=http://localhost:8080
AUTH_AUDIENCE=ecommerce-api
# Leave key paths blank for disposable development only. For a VM, place PEM
# files under JWT_KEY_DIRECTORY and set both paths to /run/secrets/jwt/<file>.
JWT_KEY_DIRECTORY=./secrets/jwt
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-admin-password

# One credential per service-to-service relationship.
INVENTORY_TO_CATALOG_TOKEN=change-me-inventory-to-catalog
ORDER_TO_CATALOG_TOKEN=change-me-order-to-catalog
CART_TO_CATALOG_TOKEN=change-me-cart-to-catalog
ORDER_TO_INVENTORY_TOKEN=change-me-order-to-inventory
SHIPPING_TO_INVENTORY_TOKEN=change-me-shipping-to-inventory
ORDER_TO_SHIPPING_TOKEN=change-me-order-to-shipping
SHIPPING_TO_ORDER_TOKEN=change-me-shipping-to-order
PAYMENT_TO_ORDER_TOKEN=change-me-payment-to-order

PAYMENT_SANDBOX_WEBHOOK_SECRET=change-me-payment-webhook-secret
SHIPPING_WEBHOOK_SECRET=change-me-shipping-webhook-secret
PAYMENT_DEFAULT_PROVIDER=SANDBOX
SHIPPING_PROVIDER=SANDBOX

# Local defaults. For HTTPS set CADDY_SITE_ADDRESS to a real DNS name and use
# 80/443 for the host ports after DNS is pointed at the VM.
CADDY_SITE_ADDRESS=:80
PROXY_HTTP_PORT=8080
PROXY_HTTPS_PORT=8443
ECOMMERCE_NETWORK_NAME=ecommerce-private
JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m

# Frontends are intentionally not part of this Compose profile. Set every
# NEXT_PUBLIC_*_API_URL to the gateway origin when running them separately.
FRONTEND_API_ORIGIN=http://localhost:8080
