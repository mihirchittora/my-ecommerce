CUSTOMER_SERVER_PORT=8086

# Host-side URL. Compose overrides this with customer-db:5432 inside the network.
CUSTOMER_DB_URL=jdbc:postgresql://localhost:5437/customer_db
CUSTOMER_DB_USERNAME=customer
CUSTOMER_DB_PASSWORD=customer

AUTH_ISSUER=http://localhost:8085
AUTH_AUDIENCE=ecommerce-api
AUTH_JWK_SET_URI=http://localhost:8085/.well-known/jwks.json

# Documented integration endpoints; Customer Service does not call these during normal /me requests.
AUTH_SERVICE_URL=http://localhost:8085
ORDER_SERVICE_URL=http://localhost:8083
CART_SERVICE_URL=http://localhost:8084

# Reserved for a future protected Auth -> Customer profile creation endpoint.
SERVICE_AUTH_TOKEN=
