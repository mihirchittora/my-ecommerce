ORDER_SERVER_PORT=8083

ORDER_DB_URL=jdbc:postgresql://localhost:5435/order_db
ORDER_DB_USERNAME=order
ORDER_DB_PASSWORD=order

CATALOG_SERVICE_URL=http://localhost:8081
INVENTORY_SERVICE_URL=http://localhost:8082
SHIPPING_SERVICE_URL=http://localhost:8088

AUTH_ISSUER=http://localhost:8085
AUTH_AUDIENCE=ecommerce-api
AUTH_JWK_SET_URI=http://localhost:8085/.well-known/jwks.json

ORDER_RESERVATION_EXPIRY_MINUTES=15
CATALOG_CONNECT_TIMEOUT_MS=2000
CATALOG_READ_TIMEOUT_MS=3000
INVENTORY_CONNECT_TIMEOUT_MS=2000
INVENTORY_READ_TIMEOUT_MS=3000

# Dedicated service-to-service credentials. Never commit real values.
CATALOG_SERVICE_TOKEN=dev-order-to-catalog
INVENTORY_SERVICE_TOKEN=dev-order-to-inventory
ORDER_TO_SHIPPING_SERVICE_TOKEN=dev-order-to-shipping
SHIPPING_TO_ORDER_SERVICE_TOKEN=dev-shipping-to-order
PAYMENT_TO_ORDER_SERVICE_TOKEN=dev-payment-to-order

FULFILLMENT_OUTBOX_POLL_MS=5000
FULFILLMENT_OUTBOX_BATCH_SIZE=20

# Set false only for local development without Auth Service.
APP_SECURITY_ENABLED=true
