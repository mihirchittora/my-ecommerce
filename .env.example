# Local development only. Copy this file to .env at the repository root.
# Do not use these values in production or commit the copied .env file.

# Auth bootstrap (used only when the Auth database is initialized).
AUTH_DB_NAME=auth_db
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=postgres
AUTH_ISSUER=http://localhost:8085
AUTH_AUDIENCE=ecommerce-api
AUTH_JWK_SET_URI=http://host.docker.internal:8085/.well-known/jwks.json
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-development-only

# Email notifications are disabled by default. Set EMAIL_ENABLED=true and
# provide SMTP credentials to send welcome, password-reset, order, payment,
# and shipment emails from the Auth and Order services.
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@morrow.local
EMAIL_FROM_NAME=Morrow Commerce
FRONTEND_BASE_URL=http://localhost:3001
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Service URLs used by Compose containers to reach services published on the host.
CATALOG_SERVICE_URL=http://host.docker.internal:8081
INVENTORY_SERVICE_URL=http://host.docker.internal:8082
ORDER_SERVICE_URL=http://host.docker.internal:8083
SHIPPING_SERVICE_URL=http://host.docker.internal:8088

# Development seed settings. The seed client talks to host-published endpoints.
SEED_ENV=development
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-development-only
SEED_AUTH_SERVICE_URL=http://localhost:8085
SEED_CATALOG_SERVICE_URL=http://localhost:8081
SEED_INVENTORY_SERVICE_URL=http://localhost:8082
SEED_ORDER_SERVICE_URL=http://localhost:8083
SEED_CART_SERVICE_URL=http://localhost:8084
SEED_CUSTOMER_SERVICE_URL=http://localhost:8086
SEED_PAYMENT_SERVICE_URL=http://localhost:8087
SEED_SHIPPING_SERVICE_URL=http://localhost:8088

# The seed tool accepts the service variable names below. They are development
# credentials only and must match the values configured for the local services.
PAYMENT_TO_ORDER_SERVICE_TOKEN=dev-payment-to-order
ORDER_TO_SHIPPING_SERVICE_TOKEN=dev-order-to-shipping
PAYMENT_SANDBOX_WEBHOOK_SECRET=dev-sandbox-webhook-secret
SHIPPING_WEBHOOK_SECRET=dev-shipping-webhook-secret

ORDER_FREE_SHIPPING_THRESHOLD=500
ORDER_STANDARD_SHIPPING_CHARGE=79
ORDER_EXPRESS_SHIPPING_CHARGE=149
ORDER_FREE_SHIPPING_COUNTRIES=IN


EMAIL_ENABLED=true
EMAIL_FROM=your-verified-brevo-sender@example.com
EMAIL_FROM_NAME=Morrow Commerce
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=bb5bcf001@smtp-brevo.com
SMTP_PASSWORD=<new SMTP key>
SMTP_AUTH=true
SMTP_STARTTLS=true