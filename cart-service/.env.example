# Local development defaults. Keep real credentials in an untracked .env file or shell environment.
CART_SERVER_PORT=8084

CART_DB_URL=jdbc:postgresql://localhost:5436/cart_db
CART_DB_USERNAME=cart
CART_DB_PASSWORD=cart

CATALOG_SERVICE_URL=http://localhost:8081
ORDER_SERVICE_URL=http://localhost:8083
INVENTORY_SERVICE_URL=http://localhost:8082

AUTH_ISSUER=http://localhost:8085
AUTH_AUDIENCE=ecommerce-api
AUTH_JWK_SET_URI=http://localhost:8085/.well-known/jwks.json

CART_CURRENCY=INR
CART_EXPIRATION_DURATION=30d
CART_MAX_ITEMS=100
CART_MAX_QUANTITY_PER_SKU=100
CART_EXPIRATION_FIXED_DELAY_MS=60000

# Dedicated Cart -> Catalog credential. Catalog does not receive customer JWTs.
CART_CATALOG_SERVICE_TOKEN=dev-cart-to-catalog

CATALOG_CONNECT_TIMEOUT_MS=2000
CATALOG_READ_TIMEOUT_MS=3000
ORDER_CONNECT_TIMEOUT_MS=2000
ORDER_READ_TIMEOUT_MS=10000

# Set false only for local development without Auth Service. Do not use in deployed environments.
APP_SECURITY_ENABLED=true
